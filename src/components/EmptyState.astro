---
interface Props {
  message?: string;
}
const { message = 'Nothing here yet — check back soon.' } = Astro.props;
---

<p class="empty">{message}</p>

<style>
  .empty {
    border: 1px dashed var(--line);
    padding: 2rem 1.25rem;
    text-align: left;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
