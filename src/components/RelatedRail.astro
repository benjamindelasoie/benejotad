---
import type { NormalizedItem } from '../lib/content';

// The REFS block — interconnection made structural. A hard-ruled catalog of
// linked items (explicit links_to first, then shared tags), not a soft
// "related posts" card. (DESIGN.md.)
interface Props {
  items: NormalizedItem[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="refs">
      <div class="hd">
        <span>Also appears in</span>
        <span>{items.length} refs</span>
      </div>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.url}>
              <span class="kind">{item.kind}</span>
              <span class="title">{item.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .refs {
    margin-top: 4rem;
    border: 1px solid var(--rule);
  }
  .hd {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 0;
  }
  a {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 1rem;
    transition: background 0.12s linear;
  }
  a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .kind {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .title {
    font-weight: 700;
  }
</style>
