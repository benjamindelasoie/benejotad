---
// Outer spacing is the caller's concern — wrap <TagList /> in an element with
// a scoped margin where needed. This component only owns the pills.
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag}`} class="tag">
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }
  .tag {
    display: inline-block;
    border: 1px solid var(--line);
    padding: 0.15rem 0.55rem;
    color: var(--muted);
    transition:
      color 0.12s linear,
      border-color 0.12s linear;
  }
  .tag:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
</style>
