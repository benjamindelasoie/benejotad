---
// Layout for standalone MDX pages (e.g. /now). MDX passes page frontmatter
// under `frontmatter`; we render the title as a styled heading and wrap the
// body in `.prose` (defined globally so it can style the MDX-injected content).
import Layout from './Layout.astro';
import { formatDate } from '../lib/content';

interface Props {
  frontmatter?: { title?: string; description?: string; updated?: string };
}
const { frontmatter } = Astro.props;
const updated = frontmatter?.updated
  ? formatDate(new Date(frontmatter.updated))
  : undefined;
---

<Layout title={frontmatter?.title} description={frontmatter?.description}>
  {
    frontmatter?.title && (
      <header class="page-head">
        <h1>{frontmatter.title}</h1>
        {updated && <p class="eyebrow updated">Updated {updated}</p>}
      </header>
    )
  }
  <div class="prose">
    <slot />
  </div>
</Layout>

<style>
  .page-head {
    margin-bottom: 2rem;
  }
  .page-head h1 {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .updated {
    margin-top: 0.25rem;
  }
</style>
