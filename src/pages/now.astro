---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getAllItems, angleOf } from '../lib/content';
import * as letterboxd from '../lib/sources/letterboxd';
import * as github from '../lib/sources/github';
import * as lastfm from '../lib/sources/lastfm';
import * as hardcover from '../lib/sources/hardcover';
import type { SourceEntry, SourceTag } from '../lib/sources/types';

// /now — a snapshot the system assembles. Four live external sources
// (Letterboxd diary, GitHub public events, Last.fm scrobbles, Hardcover
// shelf) plus two in-repo blocks (work collection + cross-collection
// recency). The sources fetch at build time; failures degrade silently
// so a flaky third party can't break the page. (DESIGN.md: one voice,
// many angles.)

const [lb, gh, lf, hc] = await Promise.all([
  letterboxd.recent(),
  github.recent(),
  lastfm.recent(),
  hardcover.recent(),
]);

const updated = new Date();

// Hand-curated rows; auto rows fall back to '—' when the source is empty.
const SOURCE_LABEL: Record<SourceTag, string> = {
  letterboxd: 'Letterboxd',
  github: 'GitHub',
  lastfm: 'Last.fm',
  hardcover: 'Hardcover',
};
const headline = (e?: SourceEntry) => e?.title ?? '—';
function relativeTime(date?: Date): string {
  if (!date) return 'no signal';
  const minutes = Math.max(0, Math.round((updated.getTime() - date.getTime()) / 60000));
  if (minutes < 2) return 'just now';
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.round(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  return `${Math.round(hours / 24)}d ago`;
}

const snapshot = [
  { label: 'Reading', source: 'hardcover', entry: hc.entries[0] },
  { label: 'Watching', source: 'letterboxd', entry: lb.entries[0] },
  { label: 'Listening', source: 'lastfm', entry: lf.entries[0] },
  { label: 'Coding', source: 'github', entry: gh.entries[0] },
  { label: 'Thinking', source: 'manual', entry: undefined },
];

// Auto — what's actively being built: the work collection, newest first. This
// site used to be pinned here as a hardcoded row, from before it had a work
// entry of its own; keeping that literal after the entry landed rendered
// benejotad twice. The collection is the only source now.
const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id),
);
const building = work.map((e) => ({
  title: e.data.title,
  role: e.data.role,
  summary: e.data.summary ?? '',
  url: `/work#${e.id}`,
}));

// Auto — out in the wild: merged feed of all external sources, newest first.
// Cap each source so a chatty one (Last.fm scrobbles fire constantly) can't
// crowd the others out.
const PER_SOURCE_CAP = 3;
const wild: SourceEntry[] = [
  ...lb.entries.slice(0, PER_SOURCE_CAP),
  ...gh.entries.slice(0, PER_SOURCE_CAP),
  ...lf.entries.slice(0, PER_SOURCE_CAP),
  ...hc.entries.slice(0, PER_SOURCE_CAP),
]
  .sort((a, b) => b.when.getTime() - a.when.getTime())
  .slice(0, 12);

// Auto — recent items across every collection (the on-site interconnection).
const lately = (await getAllItems()).slice(0, 6);

const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
---

<Layout
  title="Now"
  description="what's going on"
>
  <header class="head">
    <h1 class="title">Now</h1>
    <p class="lede">A small record of what has my attention lately.</p>
    <p class="eyebrow updated">Updated {fmtDate(updated)}</p>
    <p class="credit">
      Borrowed from <a href="https://nownownow.com/about">nownownow.com</a>.
    </p>
  </header>

  <section class="block">
    <div class="block-head">
      <span>Snapshot</span>
    </div>
    <dl class="snapshot">
      {
        snapshot.map((s) => (
          <div class="srow">
            <dt class="label">{s.label}</dt>
            <dd class:list={['value', { empty: !s.entry }]}>
              <span class="value-main">
                {s.entry?.url ? (
                  <a href={s.entry.url} class="vlink">{headline(s.entry)}</a>
                ) : (
                  headline(s.entry)
                )}
                {s.entry?.meta && <span class="meta">{s.entry.meta}</span>}
              </span>
              <span class="freshness">
                <span>
                  {s.source === 'manual' ? 'manual' : SOURCE_LABEL[s.source as SourceTag]}
                </span>
                <span>{relativeTime(s.entry?.when)}</span>
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="block">
    <div class="block-head">
      <span>Building</span>
      <span>{building.length}</span>
    </div>
    <ol class="index">
      {
        building.map((b) => (
          <li class="brow">
            <span class="role">{b.role}</span>
            <span class="main">
              <a href={b.url} class="rtitle">
                {b.title}
              </a>
              {b.summary && <span class="summary">{b.summary}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  {
    wild.length > 0 && (
      <section class="block">
        <div class="block-head">
          <span>Out in the wild</span>
          <span>{wild.length}</span>
        </div>
        <ol class="index">
          {wild.map((e) => (
            <li class="wrow">
              <span class="src">{SOURCE_LABEL[e.source]}</span>
              <time class="date" datetime={e.when.toISOString()}>
                {fmtDate(e.when)}
              </time>
              <span class="main">
                {e.url ? (
                  <a href={e.url} class="rtitle">
                    {e.title}
                  </a>
                ) : (
                  <span class="rtitle">{e.title}</span>
                )}
                {e.meta && <span class="summary">{e.meta}</span>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="block">
    <div class="block-head">
      <span>Lately on the site</span>
      <span>{lately.length}</span>
    </div>
    <ol class="index">
      {
        lately.map((item) => (
          <li class="lrow">
            <time class="date" datetime={item.date.toISOString()}>
              {fmtDate(item.date)}
            </time>
            <span class="type">{angleOf(item.kind)}</span>
            <a href={item.url} class="rtitle">
              {item.title}
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  .head {
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--rule);
  }
  .title {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 30rem;
    margin-top: 1rem;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .updated {
    margin-top: 1rem;
  }
  /* Source credit only — muted prose, same treatment as /work's intro. */
  .credit {
    margin-top: 0.75rem;
    color: var(--muted);
  }
  .credit a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .credit a:hover {
    text-decoration-thickness: 2px;
  }

  /* ---- shared block scaffold (mono header + hard rule) ---- */
  .block {
    border-bottom: 2px solid var(--rule);
  }
  .block-head {
    display: flex;
    justify-content: space-between;
    padding: 1.25rem 0 0.85rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  /* ---- snapshot: mono-labelled rows ---- */
  .snapshot {
    border-top: 1px solid var(--line);
  }
  .srow {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
  }
  .srow:last-child {
    border-bottom: 0;
  }
  .label {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
  }
  .value {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    font-size: 1.06rem;
    font-weight: 500;
  }
  .value.empty {
    color: var(--muted);
  }
  .vlink {
    text-underline-offset: 3px;
  }
  .vlink:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .value-main {
    min-width: 0;
  }
  .meta {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 400;
  }
  .freshness {
    display: flex;
    flex: 0 0 auto;
    gap: 0.75rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---- index rows (building / wild / lately) ---- */
  .index {
    border-top: 1px solid var(--line);
  }
  .brow,
  .wrow,
  .lrow {
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    gap: 1rem;
  }
  .brow:last-child,
  .wrow:last-child,
  .lrow:last-child {
    border-bottom: 0;
  }

  .brow {
    display: grid;
    grid-template-columns: 6rem 1fr;
    padding: 1.1rem 0;
  }
  .role {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .summary {
    color: var(--muted);
  }

  .wrow {
    display: grid;
    grid-template-columns: 6rem 6.5rem 1fr;
    padding: 1rem 0;
  }
  .src {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .lrow {
    display: grid;
    grid-template-columns: 6.5rem 6rem 1fr;
    padding: 1rem 0;
  }
  .date {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .type {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .rtitle {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-underline-offset: 4px;
  }
  a.rtitle:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 640px) {
    .srow {
      grid-template-columns: 7rem 1fr;
    }
    .brow {
      grid-template-columns: 5rem 1fr;
    }
    .wrow,
    .lrow {
      grid-template-columns: 2.6rem 1fr;
    }
    .value {
      display: block;
    }
    .freshness {
      margin-top: 0.45rem;
    }
    .wrow .src,
    .wrow .date,
    .wrow .main,
    .lrow .date,
    .lrow .type,
    .lrow .rtitle {
      grid-column: 2;
    }
  }
</style>
