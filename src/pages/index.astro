---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAllItems, angleOf, ANGLES } from '../lib/content';

// Home is the catalog: one filterable index of everything personal. The
// "angles" are filters that dim non-matching rows in place — you always see a
// facet in the context of the whole. (DESIGN.md: one voice, many angles.)
const items = await getAllItems();
const total = items.length;

// Distinct angles present, in a stable display order.
const angles = ANGLES.filter((a) => items.some((i) => angleOf(i.kind) === a));

const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
const catNo = (i: number) => String(total - i).padStart(3, '0');
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-label"><span class="signal-dot" aria-hidden="true"></span> personal index / {new Date().getFullYear()}</p>
      <h1 class="wordmark">benejotad</h1>
      <p class="tagline">Notes, places, projects, and other things worth keeping.</p>
    </div>
    <div class="hero-aside" aria-label="site status">
      <span class="aside-label">STATUS</span>
      <strong>in motion<span class="cursor" aria-hidden="true">_</span></strong>
      <span class="aside-detail">{total} entries / updating occasionally</span>
    </div>
  </section>

  {
    total === 0 ? (
      <EmptyState message="The first entries are on their way." />
    ) : (
      <>
        <nav class="angles" aria-label="filter by angle">
          <button type="button" class="angle is-active" data-angle="all" aria-pressed="true">
            <span class="angle-marker" aria-hidden="true"></span> All
          </button>
          {angles.map((a) => (
            <button type="button" class="angle" data-angle={a} aria-pressed="false">
              <span class="angle-marker" aria-hidden="true"></span> {a}
            </button>
          ))}
        </nav>

        <ol class="index" aria-label="catalog">
          {items.map((item, i) => (
            <li class="row" data-angle={angleOf(item.kind)}>
              <span class="no">{catNo(i)}</span>
              <time class="date" datetime={item.date.toISOString()}>
                {fmtDate(item.date)}
              </time>
              <span class="type">{angleOf(item.kind)}</span>
              <span class="main">
                <a href={item.url} class="title">
                  {item.title}
                </a>
                {item.tags.length > 0 && (
                  <span class="refs">{item.tags.map((t) => `#${t}`).join(' ')}</span>
                )}
              </span>
            </li>
          ))}
        </ol>
      </>
    )
  }
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--rule);
    margin-bottom: 0;
    position: relative;
  }
  .hero-copy { min-width: 0; }
  .hero-label { margin-bottom: 1.25rem; }
  .signal-dot {
    display: inline-block;
    width: 0.52rem;
    height: 0.52rem;
    margin-right: 0.45rem;
    background: var(--signal);
    vertical-align: 0.03em;
    animation: pulse 1.8s ease-in-out infinite;
  }
  .wordmark {
    font-size: clamp(3rem, 12vw, 7rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .tagline {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    font-weight: 500;
    max-width: 26rem;
  }
  .hero-aside {
    align-self: end;
    border-left: 2px solid var(--signal-cool);
    padding: 0.35rem 0 0.35rem 1rem;
    display: grid;
    gap: 0.35rem;
  }
  .aside-label,
  .aside-detail {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero-aside strong {
    font-size: 1.1rem;
    line-height: 1;
  }
  .cursor { color: var(--signal); }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .angles {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
  }
  .angle {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: transparent;
    color: var(--muted);
    border: 0;
    border-right: 1px solid var(--line);
    padding: 0.85rem 1.1rem;
    cursor: pointer;
    transition: color 0.12s linear, background-color 0.12s linear;
  }
  .angle:hover { color: var(--ink); background: color-mix(in srgb, var(--signal-lime) 18%, transparent); }
  .angle.is-active {
    color: var(--ink);
    background: color-mix(in srgb, var(--signal-lime) 22%, transparent);
  }
  .angle-marker {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.15rem;
    border: 1px solid currentColor;
    vertical-align: 0.02em;
  }
  .angle.is-active .angle-marker {
    border-color: var(--signal);
    background: var(--signal);
  }

  .index {
    border-bottom: 2px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 3rem 6.5rem 6rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
    transition: opacity 0.12s linear, padding-left 0.15s ease-out, border-color 0.15s linear;
    border-left: 3px solid transparent;
  }
  .row:hover {
    padding-left: 0.75rem;
    border-left-color: var(--signal);
  }
  .no {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .date {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .type {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .title {
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-underline-offset: 4px;
  }
  .title:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .row:nth-child(3n) .title:hover { text-decoration-color: var(--signal-cool); }
  .row:nth-child(3n + 1) .title:hover { text-decoration-color: var(--signal); }
  .refs {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .row[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero-aside { max-width: 15rem; }
    .row {
      grid-template-columns: 2.6rem 1fr;
    }
    .date,
    .type {
      grid-column: 2;
    }
    .main {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .signal-dot { animation: none; }
    .row { transition: opacity 0.12s linear; }
  }
</style>

<script>
  // Angle filter: dim non-matching catalog rows in place (the whole life stays
  // visible, the facet is just emphasized). Progressive enhancement — without
  // JS the full catalog renders unfiltered.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.angle');
  const rows = document.querySelectorAll<HTMLLIElement>('.row');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const want = btn.dataset.angle;
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      rows.forEach((row) => {
        const match = want === 'all' || row.dataset.angle === want;
        row.style.opacity = match ? '1' : '0.22';
      });
    });
  });
</script>
