---
import Layout from '../layouts/Layout.astro';
import ItemCard from '../components/ItemCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAllItems } from '../lib/content';

const recent = (await getAllItems()).slice(0, 6);
---

<Layout>
  <section class="hero">
    <h1>Benja</h1>
    <p class="lead">
      Software and literature, trips and films, things I build and things I think
      about. I see them as one unit seen from different angles, so this is one
      site, one voice, many views.
    </p>
    <p class="links">
      Start with <a href="/now">now</a>, browse the <a href="/work">work</a>, or
      follow a <a href="/tags">thread</a>.
    </p>
  </section>

  <section>
    <h2 class="eyebrow section-label">Recent</h2>
    {
      recent.length === 0 ? (
        <EmptyState message="The first posts are on their way." />
      ) : (
        <div class="feed">
          {recent.map((item) => (
            <ItemCard item={item} />
          ))}
        </div>
      )
    }
  </section>
</Layout>

<style>
  .hero {
    margin-bottom: 4rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .lead {
    margin-top: 1rem;
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }
  .links {
    margin-top: 0.75rem;
    max-width: 38rem;
    color: var(--color-muted);
  }
  .links a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .section-label {
    margin-bottom: 1.5rem;
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .hero h1 {
      font-size: 3rem;
    }
  }
</style>
