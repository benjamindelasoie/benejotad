---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getAllTags } from '../../lib/content';

const tags = await getAllTags();
---

<Layout title="Tags" description="The threads that connect everything on the site.">
  <header class="page-head">
    <h1>Tags</h1>
    <p class="intro">
      The threads that run through everything — pick one and follow it.
    </p>
  </header>

  {
    tags.length === 0 ? (
      <EmptyState message="No tags yet — they'll appear as content lands." />
    ) : (
      <ul class="tags">
        {tags.map(({ tag, count }) => (
          <li>
            <a href={`/tags/${tag}`} class="tag">
              <span>#{tag}</span>
              <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }
  .page-head h1 {
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .intro {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    padding: 0.3rem 0.7rem;
    transition:
      color 0.12s linear,
      border-color 0.12s linear;
  }
  .tag:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .count {
    color: var(--color-muted);
  }
</style>
